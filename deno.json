{
  "tasks": {
    "dev": "deno run --allow-net=github.com --allow-run=gh --allow-env src/cli.ts",
    "compile": "bash script/build.sh",
    "check": "deno check src/cli.ts",
    "test": "deno test -A"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "exclude": ["dist/"]
  },
  "lint": {
    "exclude": ["dist/"]
  },
  "imports": {
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.2.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "cheerio": "npm:cheerio@^1.2.0"
  }
}
